OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Poketip

# Supabase auth (https://supabase.com). Create a free project and copy the
# Project URL and the anon + service_role keys from Dashboard > Settings > API.
# The browser reads the VITE_ vars; the API functions read SUPABASE_URL,
# so set SUPABASE_URL to the same Project URL as VITE_SUPABASE_URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: per-user daily AI request limit. Defaults to 7.
AI_DAILY_LIMIT=7

# Optional: AI credits spent per request once the free daily limit is reached.
# Defaults to 1. Starting credits come from the profiles table default (30).
AI_CREDIT_COST=1

# Optional: per-IP daily AI request limit, so many accounts on one network
# cannot bypass the per-user limit. Defaults to 14 (about two accounts).
AI_IP_DAILY_LIMIT=14

# Optional: 1:1 voice/video calls. Keep these server-side (never use VITE_).
# LiveKit Cloud > project settings > Project URL and API keys.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
